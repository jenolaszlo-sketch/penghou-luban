<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <PenghouRoot Condition="'$(PenghouRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\Penghou'))</PenghouRoot>
    <PackageId>Penghou.Luban</PackageId>
    <Title>Penghou Luban</Title>
    <Description>Typed effect contracts and bounded providers for source workspace operations.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PenghouRoot)\src\Penghou.IO.Abstractions\Penghou.IO.Abstractions.csproj" />
    <ProjectReference Include="$(PenghouRoot)\src\Penghou.IO.Local\Penghou.IO.Local.csproj" />
  </ItemGroup>
</Project>



