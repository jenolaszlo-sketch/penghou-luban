<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <PenghouRoot Condition="'$(PenghouRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\Penghou'))</PenghouRoot>
    <UsePenghouSource Condition="'$(UsePenghouSource)' == ''">false</UsePenghouSource>
    <PackageId>Penghou.Luban</PackageId>
    <Title>Penghou Luban</Title>
    <Description>Authorization-aware language and bounded runtime for secure AI tool usage, with provider-neutral file operations and deterministic text changes.</Description>
    <PackageTags>ai;tools;security;authorization;workspace;language;diff;merge</PackageTags>
    <PackageReleaseNotes>Preview package. API and profiles remain subject to qualification.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <ApiCompatEnableStrictModeForCompatibleTfms>true</ApiCompatEnableStrictModeForCompatibleTfms>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePenghouSource)' != 'true'">
    <PackageReference Include="Penghou.IO.Abstractions" Version="[0.1.0-preview.1]" />
    <PackageReference Include="Penghou.IO.Protocols" Version="[0.1.0-preview.1]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePenghouSource)' == 'true'">
    <ProjectReference Include="$(PenghouRoot)\src\Penghou.IO.Abstractions\Penghou.IO.Abstractions.csproj" />
    <ProjectReference Include="$(PenghouRoot)\src\Penghou.IO.Protocols\Penghou.IO.Protocols.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="[3.3.4]" PrivateAssets="all" />
  </ItemGroup>
</Project>
